---
import type { Report, Track } from "../lib/data";

interface Props {
  track: Track;
  latest?: Report;
  total: number;
}

const { track, latest, total } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<a
  href={`${base}/${track}/`}
  class="block rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.04] hover:border-white/20 p-5 transition"
>
  <div class="flex items-baseline justify-between">
    <h3 class="text-lg mono">{track}</h3>
    <span class="text-[10px] text-white/40 mono">{total} items</span>
  </div>
  {latest ? (
    <p class="mt-3 text-xs text-white/60 mono">
      latest: {latest.mode}/{latest.slug}
    </p>
  ) : (
    <p class="mt-3 text-xs text-white/30 italic">no report yet</p>
  )}
</a>
